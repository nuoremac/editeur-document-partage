classDiagram
    class Redacteur {
        +UUID id
        +String nom
        +String email
        +DateTime creeLe
        +consulterCredit()
    }

    class Document {
        +UUID id
        +String titre
        +UUID proprietaireId
        +Long revisionCourante
        +DateTime modifieLe
        +creerVersion()
        +restaurerVersion()
    }

    class AutorisationDocument {
        +UUID documentId
        +UUID redacteurId
        +RoleDocument role
        +DateTime accordeeLe
    }

    class OperationEdition {
        +UUID operationId
        +UUID documentId
        +UUID auteurId
        +Long revision
        +Binary miseAJourCRDT
        +Integer caracteresInseres
        +DateTime accepteeLe
    }

    class VersionDocument {
        +UUID versionId
        +UUID documentId
        +Long revision
        +String cleObjet
        +String empreinte
        +DateTime creeeLe
    }

    class CreditJournalier {
        +UUID redacteurId
        +Date periode
        +Integer utilises
        +Integer limite
        +debiter(nombre)
        +solde()
    }

    class LienTelechargement {
        +UUID linkId
        +UUID documentId
        +UUID createurId
        +Integer limiteInitiale
        +Integer restant
        +EtatLien etat
        +DateTime creeLe
        +reserver()
        +epuiser()
    }

    class Reservation {
        +UUID reservationId
        +UUID linkId
        +UUID versionId
        +EtatReservation etat
        +DateTime creeeLe
        +marquerPrete()
        +marquerEchec()
    }

    class PDF {
        +UUID pdfId
        +UUID versionId
        +String cleS3
        +String empreinte
        +DateTime genereLe
    }

    class Blocage {
        +UUID blocageId
        +UUID redacteurId
        +String raison
        +DateTime debut
        +DateTime fin
        +estActif()
    }

    class Notification {
        +UUID notificationId
        +UUID linkId
        +EtatNotification etat
        +DateTime creeeLe
        +marquerEnvoyee()
    }

    Redacteur "1" --> "0..*" Document : possède
    Redacteur "1" --> "0..*" AutorisationDocument : reçoit
    Document "1" *-- "0..*" AutorisationDocument : contrôle
    Document "1" *-- "0..*" OperationEdition : journalise
    Redacteur "1" --> "0..*" OperationEdition : produit
    Document "1" *-- "0..*" VersionDocument : versionne
    Redacteur "1" *-- "0..*" CreditJournalier : consomme
    Redacteur "1" --> "0..*" Blocage : subit
    Document "1" --> "0..*" LienTelechargement : publie
    Redacteur "1" --> "0..*" LienTelechargement : crée
    LienTelechargement "1" *-- "0..*" Reservation : autorise
    VersionDocument "1" --> "0..*" Reservation : est capturée par
    VersionDocument "1" --> "0..1" PDF : est rendue en
    LienTelechargement "1" --> "0..1" Notification : déclenche

