flowchart TD
    START(["Demande visiteur"])
    VALID{"Lien valide ?"}
    RESERVE{"Réservation atomique réussie ?"}
    PDF{"PDF de la version disponible ?"}
    READY["Répondre READY avec accès temporaire"]
    QUEUE["Placer un travail PDF dans la file"]
    WAIT["Répondre QUEUED avec identifiant de suivi"]
    EXHAUSTED["Répondre EXHAUSTED"]
    INVALID["Répondre LINK_NOT_FOUND"]
    LAST{"Solde devenu zéro ?"}
    EVENT["Créer l'événement LAST_COPY"]
    STOP["Refuser les demandes suivantes sans génération"]
    END(["Fin de la requête"])

    START --> VALID
    VALID -- non --> INVALID --> END
    VALID -- oui --> RESERVE
    RESERVE -- non --> EXHAUSTED --> STOP --> END
    RESERVE -- oui --> LAST
    LAST -- oui --> EVENT --> PDF
    LAST -- non --> PDF
    PDF -- oui --> READY --> END
    PDF -- non --> QUEUE --> WAIT --> END

