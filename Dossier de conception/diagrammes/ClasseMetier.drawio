        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Redacteur {\n        +UUID id\n        +String nom\n        +String email\n        +DateTime creeLe\n        +consulterCredit()\n    }\n\n    class Document {\n        +UUID id\n        +String titre\n        +UUID proprietaireId\n        +Long revisionCourante\n        +DateTime modifieLe\n        +creerVersion()\n        +restaurerVersion()\n    }\n\n    class AutorisationDocument {\n        +UUID documentId\n        +UUID redacteurId\n        +RoleDocument role\n        +DateTime accordeeLe\n    }\n\n    class OperationEdition {\n        +UUID operationId\n        +UUID documentId\n        +UUID auteurId\n        +Long revision\n        +Binary miseAJourCRDT\n        +Integer caracteresInseres\n        +DateTime accepteeLe\n    }\n\n    class VersionDocument {\n        +UUID versionId\n        +UUID documentId\n        +Long revision\n        +String cleObjet\n        +String empreinte\n        +DateTime creeeLe\n    }\n\n    class CreditJournalier {\n        +UUID redacteurId\n        +Date periode\n        +Integer utilises\n        +Integer limite\n        +debiter(nombre)\n        +solde()\n    }\n\n    class LienTelechargement {\n        +UUID linkId\n        +UUID documentId\n        +UUID createurId\n        +Integer limiteInitiale\n        +Integer restant\n        +EtatLien etat\n        +DateTime creeLe\n        +reserver()\n        +epuiser()\n    }\n\n    class Reservation {\n        +UUID reservationId\n        +UUID linkId\n        +UUID versionId\n        +EtatReservation etat\n        +DateTime creeeLe\n        +marquerPrete()\n        +marquerEchec()\n    }\n\n    class PDF {\n        +UUID pdfId\n        +UUID versionId\n        +String cleS3\n        +String empreinte\n        +DateTime genereLe\n    }\n\n    class Blocage {\n        +UUID blocageId\n        +UUID redacteurId\n        +String raison\n        +DateTime debut\n        +DateTime fin\n        +estActif()\n    }\n\n    class Notification {\n        +UUID notificationId\n        +UUID linkId\n        +EtatNotification etat\n        +DateTime creeeLe\n        +marquerEnvoyee()\n    }\n\n    Redacteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Document : possède\n    Redacteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AutorisationDocument : reçoit\n    Document \&quot;1\&quot; *-- \&quot;0..*\&quot; AutorisationDocument : contrôle\n    Document \&quot;1\&quot; *-- \&quot;0..*\&quot; OperationEdition : journalise\n    Redacteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OperationEdition : produit\n    Document \&quot;1\&quot; *-- \&quot;0..*\&quot; VersionDocument : versionne\n    Redacteur \&quot;1\&quot; *-- \&quot;0..*\&quot; CreditJournalier : consomme\n    Redacteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Blocage : subit\n    Document \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LienTelechargement : publie\n    Redacteur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LienTelechargement : crée\n    LienTelechargement \&quot;1\&quot; *-- \&quot;0..*\&quot; Reservation : autorise\n    VersionDocument \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reservation : est capturée par\n    VersionDocument \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PDF : est rendue en\n    LienTelechargement \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Notification : déclenche\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Ur0Cy400S52IsO27L5Rn-1">
