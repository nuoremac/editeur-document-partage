flowchart TB
    subgraph Clients["Clients"]
        R["Navigateur rédacteur"]
        V["Navigateur visiteur"]
        A["Navigateur administrateur"]
    end

    FE["Application web statique"]
    HTTP["API HTTP<br/>validation identité et droits"]
    WS["Passerelle WebSocket"]

    subgraph Services["Services applicatifs"]
        DOC["Service documents et versions"]
        COLLAB["Service collaboratif CRDT<br/>opérations, crédit et diffusion"]
        PUB["Service de publication<br/>réservation atomique et état du lien"]
        ADMIN["Service d'administration<br/>consultation en lecture"]
        PDF["Générateur PDF"]
        OUTBOX["Relais d'événements idempotent"]
    end

    DB[("Stockage métier<br/>documents, opérations, liens,<br/>réservations, crédits et outbox")]
    PRESENCE[("Présence et curseurs<br/>état éphémère avec expiration")]
    SNAP[("S3<br/>versions immuables et PDF")]
    QUEUE[["File de travaux PDF"]]
    MAILQ[["File de notifications"]]
    MAIL["Service d'e-mail"]
    OBS["Journaux, métriques et alarmes"]

    R --> FE
    V --> FE
    A --> FE
    FE <--> HTTP
    FE <--> WS

    HTTP --> DOC
    HTTP --> PUB
    HTTP --> ADMIN
    WS <--> COLLAB

    DOC <--> DB
    DOC --> SNAP
    COLLAB <--> DB
    COLLAB <--> PRESENCE
    PUB -->|"transaction conditionnelle : décrémenter quota, créer réservation et capturer versionId"| DB
    PUB -->|"si PDF de versionId absent"| QUEUE
    QUEUE --> PDF
    PDF -->|"lire la version immuable"| SNAP
    PDF -->|"écrire PDF et empreinte"| SNAP
    PDF -->|"mettre à jour l'état de génération"| DB
    PUB -->|"retour : prêt, en attente ou épuisé"| HTTP
    HTTP -->|"URL d'accès temporaire après réservation"| FE
    FE -->|"téléchargement du PDF autorisé"| SNAP

    DB -->|"lecture des événements d'outbox créés avec la réservation"| OUTBOX
    OUTBOX -->|"événement idempotent"| MAILQ
    MAILQ --> MAIL

    ADMIN -->|"lecture des documents, liens et blocages"| DB
    DOC -. métriques .-> OBS
    COLLAB -. métriques .-> OBS
    PUB -. métriques .-> OBS
    PDF -. métriques .-> OBS
    OUTBOX -. métriques .-> OBS

    classDef datastore fill:#eef,stroke:#446;
    class DB,PRESENCE,SNAP datastore;
