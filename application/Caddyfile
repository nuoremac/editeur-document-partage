{$APP_DOMAIN} {
    encode zstd gzip

    @api path /api/* /health
    handle @api {
        reverse_proxy {$API_UPSTREAM}
    }

    @websocket path /ws/*
    handle @websocket {
        reverse_proxy {$API_UPSTREAM}
    }

    handle {
        reverse_proxy {$WEB_UPSTREAM}
    }
}
