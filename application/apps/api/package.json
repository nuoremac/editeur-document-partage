{
  "name": "@journal/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "DOTENV_CONFIG_PATH=../../.env node dist/server.js",
    "worker": "DOTENV_CONFIG_PATH=../../.env node dist/worker.js",
    "migrate": "DOTENV_CONFIG_PATH=../../.env node src/migrate.js",
    "test": "DOTENV_CONFIG_PATH=../../.env tsx --test src/*.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@types/ws": "^8.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
