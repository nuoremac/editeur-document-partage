{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPublishedPdfsForSignedDownloads",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/pdf/*"
    },
    {
      "Sid": "EnqueuePdfJobs",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:REPLACE_WITH_REGION:REPLACE_WITH_ACCOUNT_ID:REPLACE_WITH_QUEUE_NAME"
    }
  ]
}
